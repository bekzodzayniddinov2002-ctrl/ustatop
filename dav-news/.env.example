# Anthropic API kaliti (https://console.anthropic.com). Bo'sh qoldirilsa ilova DEMO rejimida ishlaydi.
ANTHROPIC_API_KEY=

# Asosiy tahlil modeli (5-qadam: qiyosiy tahlil)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Tezkor model (3-qadam: eski hujjat havolalarini aniqlash). Arzonroq variant.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# DEMO rejimi: auto (kalit bo'lmasa demo) | true (har doim demo) | false (hech qachon)
MOCK_MODE=auto

# Standart tuman/shahar (tahlil shu hudud uchun moslanadi)
DEFAULT_DISTRICT=Konimex tumani, Navoiy viloyati

# Lex.uz sozlamalari
LEXUZ_BASE_URL=https://lex.uz
LEXUZ_LANG=uz
LEXUZ_TIMEOUT_MS=20000
