# Docker Compose uchun ixtiyoriy sozlamalar.
# Ishlatish uchun nusxa oling:  cp .env.example .env

# Dev-server host'da qaysi portda ochilsin
DEV_PORT=5173

# Ishlab chiqarish (nginx) konteyneri porti
PROD_PORT=8080

# Fayl o'zgarishini kuzatish rejimi.
#   true  — macOS / Windows (Docker Desktop): bind mount inotify'ni yetkazmaydi
#   false — Linux: inotify ishlaydi, protsessor yuki kamayadi
VITE_POLLING=true
